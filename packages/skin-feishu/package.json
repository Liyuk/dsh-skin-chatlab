{
  "name": "@liyuk/dsh-skin-feishu",
  "version": "1.0.2",
  "description": "飞书皮肤包：DeepSeek Harness (DSH) 的飞书/Lark 风格聊天皮肤。依赖 @liyuk/dsh-skin-chatlab-core 基座。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@liyuk/dsh-skin-chatlab-core": "^1.0.2"
  }
}
